#!/usr/bin/env bash
# If a frame heading has no chronohex, write one at the end of its bracket.
# Chronohex: last six hex digits of Unix time in nanoseconds.
set -euo pipefail

msg_file=$1
source=${2:-}

case "$source" in
  merge|squash) exit 0 ;;
esac

if grep -qE '\[.*[0-9a-f]{6}.*\]|⟳ [0-9a-f]{6}' "$msg_file"; then
  exit 0
fi

chx="$(python3 -c 'import time; print(hex(time.time_ns())[-6:])')"

python3 - "$msg_file" "$chx" <<'PY'
import re
import sys

path, chx = sys.argv[1], sys.argv[2]
lines = open(path).read().splitlines(keepends=True)
pattern = re.compile(r"^([╔╭].*\[)([^\]]*)(\].*)$")
for i, line in enumerate(lines):
    body = line[:-1] if line.endswith("\n") else line
    match = pattern.match(body)
    if not match:
        continue
    title = match.group(2).strip()
    if title in {"", "title chronohex"}:
        title = chx
    else:
        title = f"{title} {chx}"
    nl = "\n" if line.endswith("\n") else ""
    lines[i] = f"{match.group(1)} {title} {match.group(3)}{nl}"
    break
open(path, "w").writelines(lines)
PY
